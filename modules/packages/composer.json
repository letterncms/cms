{
    "name": "letterncms/packages",
    "description": "Turns plugins and modules on and off.",
    "type": "cms-plugin",
    "version": "0.36.0",
    "license": "MIT",
    "require": {
        "letterncms/cms": "*"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Modules\\Packages\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Modules",
            "icon": "plugin",
            "provider": "Cms\\Modules\\Packages\\PackagesModule",
            "required": true
        }
    }
}
