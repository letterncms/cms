{
    "name": "letterncms/license",
    "description": "Checks the keys of paid plugins. Does nothing on a site without one, and never touches the public site.",
    "type": "cms-plugin",
    "version": "0.30.2",
    "license": "MIT",
    "require": {
        "letterncms/cms": "*"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Modules\\License\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Paid Plugins",
            "icon": "key",
            "provider": "Cms\\Modules\\License\\LicenseModule",
            "required": true
        }
    }
}
