{
    "name": "letterncms/media",
    "description": "Media library: safe uploads, folders, alt text, focal points and responsive AVIF/WebP images.",
    "type": "cms-plugin",
    "version": "0.7.0",
    "license": "MIT",
    "require": {
        "letterncms/cms": "*"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Modules\\Media\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Media",
            "icon": "media",
            "provider": "Cms\\Modules\\Media\\MediaModule",
            "required": true
        }
    }
}
