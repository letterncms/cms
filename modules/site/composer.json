{
    "name": "letterncms/site",
    "description": "The design, page templates and the site renderer, with previews and static builds.",
    "type": "cms-plugin",
    "version": "0.36.2",
    "license": "MIT",
    "require": {
        "letterncms/cms": "*"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Modules\\Site\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Site",
            "icon": "palette",
            "provider": "Cms\\Modules\\Site\\SiteModule",
            "modules": [
                "letterncms/blocks"
            ]
        }
    }
}
