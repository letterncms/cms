{
    "name": "letterncms/site",
    "description": "Design system (content/design), page templates, routing, rendering, previews and static builds.",
    "type": "cms-plugin",
    "version": "0.20.0",
    "license": "MIT",
    "require": {
        "letterncms/cms": "*"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Modules\\Site\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Site",
            "icon": "globe",
            "provider": "Cms\\Modules\\Site\\SiteModule",
            "modules": [
                "letterncms/blocks"
            ]
        }
    }
}
