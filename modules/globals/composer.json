{
    "name": "letterncms/globals",
    "description": "Site-wide values such as contact details or a footer, in globals with fields of their own.",
    "type": "cms-plugin",
    "version": "0.33.0",
    "license": "MIT",
    "require": {
        "letterncms/cms": "*"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Modules\\Globals\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Globals",
            "icon": "globe",
            "provider": "Cms\\Modules\\Globals\\GlobalsModule"
        }
    }
}
