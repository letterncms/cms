{
    "name": "letterncms/assistant",
    "description": "Claude in the workspace: it answers in plain words and builds and edits the site with abilities, as the signed-in user.",
    "type": "cms-plugin",
    "version": "0.27.0",
    "license": "MIT",
    "require": {
        "letterncms/cms": "*"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Modules\\Assistant\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Assistant",
            "icon": "sparkle",
            "provider": "Cms\\Modules\\Assistant\\AssistantModule"
        }
    }
}
