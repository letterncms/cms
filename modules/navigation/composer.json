{
    "name": "letterncms/navigation",
    "description": "Menus: nested links to entries and URLs, edited with drag and drop, shown with the Repeat block and kept in sync when pages move.",
    "type": "cms-plugin",
    "version": "0.35.1",
    "license": "MIT",
    "require": {
        "letterncms/cms": "*"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Modules\\Navigation\\": "src/"
        }
    },
    "extra": {
        "cms": {
            "label": "Navigation",
            "icon": "list-tree",
            "provider": "Cms\\Modules\\Navigation\\NavigationModule",
            "required": true
        }
    }
}
