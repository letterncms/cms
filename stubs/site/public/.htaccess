# Uploaded and generated files must never execute.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>

# What scripts load from the media library: the type a loader expects, and cached like the other files
# whose name never gets new contents.
<IfModule mod_mime.c>
    AddType model/gltf-binary .glb
    AddType model/gltf+json .gltf
    AddType image/vnd.radiance .hdr
    AddType image/ktx2 .ktx2
    AddType application/vnd.rive .riv
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(glb|gltf|hdr|ktx2|riv)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
    # A Lottie animation: the only .json under media/.
    <If "%{REQUEST_URI} =~ m#/media/.+\.json$#">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set X-Content-Type-Options "nosniff"
    </If>
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
