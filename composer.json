{
    "name": "letterncms/cms",
    "description": "The kernel \u2014 plugins, abilities, content, users and APIs.",
    "type": "library",
    "version": "0.25.0",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "anthropic-ai/sdk": "^1.3",
        "composer/semver": "^3.4",
        "laravel/framework": "^13.0",
        "league/commonmark": "^2.6",
        "letterncms/composer-plugin": ">=0.1 <1",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "conflict": {
        "letterncms/analytics": "<0.7",
        "letterncms/brevo": "<0.5",
        "letterncms/forms": "<0.12",
        "letterncms/market": "<0.15",
        "letterncms/seo": "<0.8"
    },
    "autoload": {
        "psr-4": {
            "Cms\\": "src/",
            "Cms\\Modules\\Account\\": "modules/account/src/",
            "Cms\\Modules\\Assistant\\": "modules/assistant/src/",
            "Cms\\Modules\\Audit\\": "modules/audit/src/",
            "Cms\\Modules\\Blocks\\": "modules/blocks/src/",
            "Cms\\Modules\\Collaboration\\": "modules/collaboration/src/",
            "Cms\\Modules\\Collections\\": "modules/collections/src/",
            "Cms\\Modules\\Content\\": "modules/content/src/",
            "Cms\\Modules\\Dashboard\\": "modules/dashboard/src/",
            "Cms\\Modules\\Email\\": "modules/email/src/",
            "Cms\\Modules\\Globals\\": "modules/globals/src/",
            "Cms\\Modules\\Languages\\": "modules/languages/src/",
            "Cms\\Modules\\License\\": "modules/license/src/",
            "Cms\\Modules\\Mcp\\": "modules/mcp/src/",
            "Cms\\Modules\\Media\\": "modules/media/src/",
            "Cms\\Modules\\Navigation\\": "modules/navigation/src/",
            "Cms\\Modules\\Packages\\": "modules/packages/src/",
            "Cms\\Modules\\Settings\\": "modules/settings/src/",
            "Cms\\Modules\\Site\\": "modules/site/src/",
            "Cms\\Modules\\Sync\\": "modules/sync/src/",
            "Cms\\Modules\\Users\\": "modules/users/src/",
            "Cms\\Modules\\Workspace\\": "modules/workspace/src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Cms\\Tests\\": "tests/",
            "Cms\\Modules\\Admin\\Tests\\": "modules/admin/tests/",
            "Cms\\Modules\\Assistant\\Tests\\": "modules/assistant/tests/",
            "Cms\\Modules\\Blocks\\Tests\\": "modules/blocks/tests/",
            "Cms\\Modules\\Collaboration\\Tests\\": "modules/collaboration/tests/",
            "Cms\\Modules\\Email\\Tests\\": "modules/email/tests/",
            "Cms\\Modules\\Languages\\Tests\\": "modules/languages/tests/",
            "Cms\\Modules\\License\\Tests\\": "modules/license/tests/",
            "Cms\\Modules\\Mcp\\Tests\\": "modules/mcp/tests/",
            "Cms\\Modules\\Media\\Tests\\": "modules/media/tests/",
            "Cms\\Modules\\Navigation\\Tests\\": "modules/navigation/tests/",
            "Cms\\Modules\\Packages\\Tests\\": "modules/packages/tests/",
            "Cms\\Modules\\Site\\Tests\\": "modules/site/tests/",
            "Cms\\Modules\\Sync\\Tests\\": "modules/sync/tests/",
            "Cms\\Modules\\Users\\Tests\\": "modules/users/tests/",
            "Cms\\Modules\\Workspace\\Tests\\": "modules/workspace/tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "letterncms/composer-plugin": true
        },
        "sort-packages": true
    },
    "homepage": "https://github.com/letterncms/cms"
}
